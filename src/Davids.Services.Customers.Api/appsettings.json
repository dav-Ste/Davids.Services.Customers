{
  "AllowedHosts": "*",
  "CustomerOidc": {
    "Audience": "davids-services"
  },
  "AdminOidc": {
    "Audience": "davids-admin"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Messaging": {
    "Enabled": false
  },
  "Http": {
    "AllowInsecureDevelopment": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
